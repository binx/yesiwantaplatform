<h1 style="margin:0 0 12px;font-size:24px;font-weight:600;">Your order is on its way</h1>
{{#if order.trackingNumber}}
<p style="margin:0 0 8px;color:#52525b;line-height:1.6;">
  Tracking number{{#if order.carrier}} ({{order.carrier}}){{/if}}:
  <strong style="color:#18181b;">{{order.trackingNumber}}</strong>
</p>
{{else}}
<p style="margin:0 0 8px;color:#52525b;line-height:1.6;">Your order has been dispatched.</p>
{{/if}}
{{> items}}
