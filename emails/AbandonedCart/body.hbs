<h1 style="margin:0 0 12px;font-size:24px;font-weight:600;">Your postcards are still waiting</h1>
<p style="margin:0 0 8px;color:#52525b;line-height:1.6;">
  You designed some postcards at {{store.name}} and didn't finish sending them. They're still here.
</p>

{{#if items}}
<table style="width:100%;border-collapse:collapse;font-size:14px;margin:24px 0;">
  <tbody>
    {{#each items}}
    <tr>
      <td style="padding:12px 0;border-bottom:1px solid #f4f4f5;">
        {{this.summary}}
        <div style="color:#71717a;font-size:12px;">{{this.count}} postcard{{#unless (eq this.count 1)}}s{{/unless}}</div>
      </td>
      <td style="padding:12px 0;border-bottom:1px solid #f4f4f5;text-align:right;">{{this.lineTotal}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>

<table style="width:100%;font-size:14px;">
  <tr style="font-weight:600;"><td>Subtotal</td><td style="text-align:right;">{{subtotal}}</td></tr>
</table>
{{/if}}

{{#if droppedCount}}
<p style="margin:16px 0 0;color:#71717a;font-size:13px;line-height:1.6;">
  {{droppedCount}} postcard(s) in your cart have since been cleaned up and weren't included above.
</p>
{{/if}}

<p style="margin:24px 0;">
  <a href="{{recoverUrl}}" style="display:inline-block;background:{{store.colorAccent}};color:#18181b;text-decoration:none;padding:10px 20px;border-radius:2px;font-weight:600;">Pick up where you left off</a>
</p>

<p style="margin:0;color:#71717a;font-size:13px;line-height:1.6;">
  This link works once and expires in 7 days.
  <a href="{{unsubscribeUrl}}" style="color:#71717a;">Unsubscribe</a> from cart reminders.
</p>
