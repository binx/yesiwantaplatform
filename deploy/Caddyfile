# Caddy in front of the API. Installed to /etc/caddy/Caddyfile by
# deploy/provision.sh, which fills in DOMAIN and STAGING_HOST.
#
# Caddy gets and renews the Let's Encrypt certificates itself. Until the
# domain's A record points here it keeps retrying the domain in the
# background and serves the staging host, which resolves anywhere.

DOMAIN, www.DOMAIN, STAGING_HOST {
	encode zstd gzip

	# Long-lived uploads and the hashed Vite bundle are cached by the app's
	# own headers; nothing to add here.
	reverse_proxy 127.0.0.1:4000

	log {
		output file /var/log/caddy/access.log {
			roll_size 20mb
			roll_keep 5
		}
	}
}

# Plain http on the raw address answers the health check before DNS is
# switched; nothing that sets a cookie works here because the session
# cookie is Secure in production.
http://SERVER_IP {
	reverse_proxy 127.0.0.1:4000
}
