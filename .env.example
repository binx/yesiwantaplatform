# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
# In production, use the platform's environment variables instead.

# --- Client (Vite exposes anything prefixed VITE_ to the browser) ------------
# Set to "false" to render the bundled fixture instead of calling the API.
VITE_BELUGA_API=true

# --- Server ------------------------------------------------------------------
# SQLite by default; no database server to run.
# Point at Postgres if you prefer: postgres://user:pass@host:5432/db
DATABASE_URL=file:./data/postcards.sqlite

# Stripe. The secret key is server-only and must never be sent to the browser.
# The publishable key is public by design and is served via /api/store.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Lob prints and mails the postcards. A test_ key talks to Lob's sandbox,
# where nothing is printed; a live_ key costs money per card. Without one,
# paid orders wait at "scheduled" and the admin overview says so.
# LOB_API_KEY=test_...

# Delivery tracking. Create a webhook in the Lob dashboard pointed at
# <PUBLIC_URL>/api/webhooks/lob, subscribe it to the postcard.* events, and
# paste its signing secret here. Without it no tracking is recorded.
# LOB_WEBHOOK_SECRET=...
#
# Optional: a Lob HTML template (tmpl_...) for the back of the card, sent with
# the same merge variables v1 used (postcard_text, postcard_valediction,
# font_name, font_size, font_color). Unset, the back is rendered from
# print/back.hbs in this repo and sent as HTML.
# LOB_BACK_TEMPLATE_ID=tmpl_...
#
# Lob requires every mailpiece to say what kind of mail it is. A postcard a
# person writes to a friend is "operational"; change it if you use Lob
# differently.
# LOB_USE_TYPE=operational

# Signs session cookies. Generate with: openssl rand -base64 32
# Required in production.
# SESSION_SECRET=

# API port. Separate from Vite's PORT so `npm run dev:all` works.
# Avoid 5000 on macOS: ControlCenter (AirPlay Receiver) already binds it.
API_PORT=4000

# Interface to bind. Leave it for containers and platforms. On a VM with
# nginx or Caddy on the same box, set 127.0.0.1.
# API_HOST=0.0.0.0

# Which proxy hops to believe about the client's address and protocol.
# Defaults to 1 in production and false otherwise.
# TRUST_PROXY=1

# The first-run wizard is public until the store has an administrator. In
# production the server prints a one-off token at boot that the wizard asks
# for; set this to choose the value instead.
# SETUP_TOKEN=

# Public origin: where buyers reach the store. Behind Stripe's success and
# cancel URLs, the sitemap, the Open Graph tags, and every emailed link.
# PUBLIC_URL=http://localhost:5173

# Where uploaded images — the store's own, and every postcard design's print
# file and thumbnail — are written and served from. On a platform that
# rebuilds the filesystem on deploy, point this at a mounted volume, or use
# the bucket settings below. The URL never changes: /assets/<path>.
# ASSETS_DIR=public/assets

# Or keep uploads in an S3-compatible bucket instead of on disk.
# ASSETS_S3_BUCKET=
# ASSETS_S3_REGION=auto
# ASSETS_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# ASSETS_S3_ACCESS_KEY_ID=
# ASSETS_S3_SECRET_ACCESS_KEY=
# ASSETS_S3_ACL=
# ASSETS_PUBLIC_URL=https://images.example.com

# Largest photo a buyer may upload, in bytes. 20 MB by default.
# MAX_UPLOAD_BYTES=20971520

# --- Email (optional) --------------------------------------------------------
# Any SMTP provider. Until these are set, sending is a logged no-op.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# EMAIL_FROM="Postcard Gifts <hi@postcardgifts.com>"
