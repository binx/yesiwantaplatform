# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
# In v1 these lived in a tracked-by-default `config.env` that the server also
# rewrote at runtime to persist the admin password hash. v2 keeps secrets out of
# the repo entirely: `.env` locally, platform environment variables in
# production (Fly, Railway, Render, and similar all inject them).

# --- Client (Vite exposes anything prefixed VITE_ to the browser) ------------
# Set to "false" to render the bundled demo fixture instead of calling the API,
# which is handy for UI work with no database running.
VITE_BELUGA_API=true

# --- Server (Phase 2) --------------------------------------------------------
# SQLite by default; no database server to run.
# Point at Postgres for high-inventory stores: postgres://user:pass@host:5432/db
DATABASE_URL=file:./data/beluga.sqlite

# Stripe. The secret key is server-only and must never be sent to the browser.
# The publishable key is public by design and is served via /api/store.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Signs session cookies. Generate with: openssl rand -base64 32
# SESSION_SECRET=

# API port. Separate from Vite's PORT so `npm run dev:all` works.
# Avoid 5000 on macOS: ControlCenter (AirPlay Receiver) already binds it.
API_PORT=4000

# Public origin, used to build Stripe success and cancel URLs.
# PUBLIC_URL=http://localhost:5173

# --- Email (optional) --------------------------------------------------------
# Any SMTP provider. Until these are set, sending is a logged no-op rather than
# an error, so a store can take orders before its email is wired up.
# v1 hard-coded a Gmail OAuth2 transport and six EMAIL_* variables.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# EMAIL_FROM="My Store <orders@example.com>"
