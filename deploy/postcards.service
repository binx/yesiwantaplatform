# systemd unit for the Postcard Gifts API. Installed by deploy/provision.sh.
#
# The process serves the built storefront from dist/ and the API on
# 127.0.0.1:4000; Caddy terminates TLS in front of it. Everything it needs
# to know is in /srv/postcards/.env — the same variables as .env.example.

[Unit]
Description=Postcard Gifts (postcardgifts.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=postcards
Group=postcards
WorkingDirectory=/srv/postcards/app
EnvironmentFile=/srv/postcards/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist-server/server/index.js
Restart=always
RestartSec=3
# The sweep and the session-store prune are unref'd timers; give the server
# time to finish an in-flight Lob request before it is killed.
TimeoutStopSec=20
KillSignal=SIGTERM

# Hardening. The process may write only to its database and uploads dirs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/postcards/data /srv/postcards/assets

[Install]
WantedBy=multi-user.target
