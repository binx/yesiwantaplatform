<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <link href="{{cardFontsUrl}}" rel="stylesheet" />
    <style>
      /*
       * The back of a 4×6 postcard, as Lob prints it.
       *
       * The page is 6.25in × 4.25in including bleed. Lob overlays the address
       * block and the postage on the right-hand half and the bottom edge, so
       * everything of ours stays in the left column: a safe area 1/8in inside
       * the trim, and a column 2.8in wide. Sizes are in inches and points so
       * the renderer's DPI does not change the layout.
       *
       * What goes there is a caption, as on a postcard from a museum shop:
       * the title of the piece, the artist, and where it came from, in small
       * type at the top of the column, with the rest left for a note.
       */
      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; width: 6.25in; height: 4.25in; }
      body { background: #ffffff; position: relative; }
      .safe {
        position: absolute;
        top: 0.25in;
        left: 0.25in;
        width: 2.8in;
        height: 3.75in;
        border-right: 1px solid #999;
        padding-right: 0.15in;
        font-family: {{fontFamily}};
        color: #222;
        overflow: hidden;
        word-wrap: break-word;
      }
      .caption { font-size: 9.5pt; line-height: 1.35; }
      .title { font-style: italic; }
      .artist { margin-top: 0.02in; }
      .site { margin-top: 0.06in; font-size: 7pt; color: #777; }
    </style>
  </head>
  <body>
    <div class="safe">
      <div class="caption">
        {{#if title}}<div class="title">{{title}}</div>{{/if}}
        <div class="artist">{{artistName}}</div>
        <div class="site">A postcard edition from {{siteName}}</div>
      </div>
    </div>
  </body>
</html>
