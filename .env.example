# Copy to `.env` and fill in. `.env` is gitignored — never commit real keys.
#
# In v1 these lived in a tracked-by-default `config.env` that the server also
# rewrote at runtime to persist the admin password hash. v2 keeps secrets out of
# the repo entirely: `.env` locally, platform environment variables in
# production (Fly, Railway, Render, and similar all inject them).

# --- Client (Vite exposes anything prefixed VITE_ to the browser) ------------
# Set to "false" to render the bundled demo fixture instead of calling the API,
# which is handy for UI work with no database running.
VITE_BELUGA_API=true

# --- Server (Phase 2) --------------------------------------------------------
# SQLite by default; no database server to run.
# Point at Postgres for high-inventory stores: postgres://user:pass@host:5432/db
DATABASE_URL=file:./data/beluga.sqlite

# Stripe. The secret key is server-only and must never be sent to the browser.
# The publishable key is public by design and is served via /api/store.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Signs session cookies. Generate with: openssl rand -base64 32
# Optional in development, but without it a fresh one is generated on every
# boot, so restarting the API signs you out. Required in production.
# SESSION_SECRET=

# API port. Separate from Vite's PORT so `npm run dev:all` works.
# Avoid 5000 on macOS: ControlCenter (AirPlay Receiver) already binds it.
API_PORT=4000

# Interface to bind. Leave it for containers and platforms, where only the
# platform's edge can reach the port. On a VM with nginx or Caddy on the same
# box, set 127.0.0.1 so the Node port is not also reachable from the internet
# with whatever X-Forwarded-* headers a caller cares to send.
# API_HOST=0.0.0.0

# Which proxy hops to believe about the client's address and protocol: false,
# true, a hop count, or a comma-separated list of addresses or subnets. The
# login rate limit and the Secure session cookie both depend on this. Defaults
# to 1 in production (one load balancer or reverse proxy in front) and false
# otherwise. Trusting more hops than exist lets a caller choose their own IP.
# TRUST_PROXY=1

# The first-run wizard is public until the store has an administrator, so on a
# public address it is a race against every scanner on the internet. In
# production the server prints a one-off token at boot that the wizard asks
# for; set this to choose the value instead (for example when the log is not
# easy to read). Not needed when the admin is created with `npm run setup` or
# ADMIN_EMAIL / ADMIN_PASSWORD before the server is exposed.
# SETUP_TOKEN=

# Public origin: where shoppers reach the store. Behind Stripe's success and
# cancel URLs, the sitemap and robots file, the canonical and Open Graph tags,
# and the links in every email. A deploy that leaves this at the default fails
# silently — pages render and checkout works, and the buyer is returned to a
# machine that is not theirs. `npm run setup` asks for it.
# PUBLIC_URL=http://localhost:5173

# Where uploaded product images are written and served from. Relative to the
# working directory. On any platform that rebuilds the filesystem on deploy,
# point this at a mounted volume — the same one that holds the SQLite file
# works — or every image vanishes with the next release. The URL never changes:
# images are served at /assets/<path> whatever this is set to.
# ASSETS_DIR=public/assets

# Or keep uploaded images in an S3-compatible bucket instead of on disk — AWS,
# DigitalOcean Spaces, Cloudflare R2, Backblaze, MinIO — which is what lets
# Beluga run on a platform with no persistent disk, and lets a Postgres
# deployment run more than one instance. Setting the bucket makes the region,
# both keys and the public URL required; a half-configured group is refused at
# boot rather than failing on the first upload. The URL still never changes:
# /assets/<path> answers with a redirect to ASSETS_PUBLIC_URL/<path>, so that
# is the bucket's public address or the CDN in front of it. ENDPOINT is for a
# provider other than AWS itself; ACL is for one that wants `public-read` set
# per object (Spaces does; AWS with bucket-owner-enforced ownership rejects it).
# ASSETS_S3_BUCKET=
# ASSETS_S3_REGION=auto
# ASSETS_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# ASSETS_S3_ACCESS_KEY_ID=
# ASSETS_S3_SECRET_ACCESS_KEY=
# ASSETS_S3_ACL=
# ASSETS_PUBLIC_URL=https://images.example.com

# --- Email (optional) --------------------------------------------------------
# Any SMTP provider. Until these are set, sending is a logged no-op rather than
# an error, so a store can take orders before its email is wired up.
# v1 hard-coded a Gmail OAuth2 transport and six EMAIL_* variables.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# EMAIL_FROM="My Store <orders@example.com>"

# --- Outbound webhooks (optional) --------------------------------------------
# Endpoint URLs are checked against the address their hostname *resolves to*,
# and anything private or reserved is refused — otherwise a merchant could point
# Beluga at 169.254.169.254 and read the host's cloud metadata out of the
# delivery log. Set this to "true" only if your receiver genuinely listens on
# localhost or a private network; it also allows plain http://.
# WEBHOOK_ALLOW_INSECURE_TARGETS=false
