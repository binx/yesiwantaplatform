<table style="width:100%;border-collapse:collapse;font-size:14px;margin:24px 0;">
  <thead>
    <tr style="font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:#71717a;">
      <th style="text-align:left;padding:0 0 8px;border-bottom:1px solid #e4e4e7;">Item</th>
      <th style="text-align:right;padding:0 0 8px;border-bottom:1px solid #e4e4e7;">Qty</th>
      <th style="text-align:right;padding:0 0 8px;border-bottom:1px solid #e4e4e7;">Total</th>
    </tr>
  </thead>
  <tbody>
    {{#each order.items}}
    <tr>
      <td style="padding:12px 0;border-bottom:1px solid #f4f4f5;">
        {{this.productName}}
        {{#if this.variantLabel}}<div style="color:#71717a;font-size:12px;">{{this.variantLabel}}</div>{{/if}}
        {{#if this.optionsText}}<div style="color:#71717a;font-size:12px;">{{this.optionsText}}</div>{{/if}}
      </td>
      <td style="padding:12px 0;border-bottom:1px solid #f4f4f5;text-align:right;">{{this.quantity}}</td>
      <td style="padding:12px 0;border-bottom:1px solid #f4f4f5;text-align:right;">{{this.lineTotal}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>

<table style="width:100%;font-size:14px;">
  <tr style="color:#52525b;"><td>Subtotal</td><td style="text-align:right;">{{order.subtotal}}</td></tr>
  {{#if order.hasDiscount}}<tr style="color:#52525b;"><td>Discount</td><td style="text-align:right;">{{order.discount}}</td></tr>{{/if}}
  <tr style="color:#52525b;"><td>Shipping</td><td style="text-align:right;">{{order.shippingCost}}</td></tr>
  {{#if order.hasTax}}<tr style="color:#52525b;"><td>Tax</td><td style="text-align:right;">{{order.tax}}</td></tr>{{/if}}
  <tr style="font-weight:600;"><td style="padding-top:8px;">Total</td><td style="text-align:right;padding-top:8px;">{{order.total}}</td></tr>
</table>

{{#if order.shipping.line1}}
<div style="margin-top:28px;font-size:13px;color:#52525b;">
  <div style="font-weight:600;color:#18181b;margin-bottom:4px;">Shipping to</div>
  <div>{{order.shipping.name}}</div>
  <div>{{order.shipping.line1}}</div>
  {{#if order.shipping.line2}}<div>{{order.shipping.line2}}</div>{{/if}}
  <div>{{order.shipping.city}}{{#if order.shipping.state}}, {{order.shipping.state}}{{/if}} {{order.shipping.postalCode}}</div>
  <div>{{order.shipping.country}}</div>
</div>
{{/if}}
