/coverage
/playwright-report
/test-results
/blob-report
/.playwright

# editor / OS
.DS_Store
*.swp
.idea

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# local tooling config (machine-specific paths)
/.claude/
